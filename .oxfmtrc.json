{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 88,
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "packages/api/src/generated.ts",
    "apps/web/src/routeTree.gen.ts",
    "bun.lock",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "target/",
    ".local/",
    ".turbo/",
    ".expo/",
    "apps/mobile/android/",
    "apps/mobile/ios/",
    "apps/mobile/expo-env.d.ts",
    "apps/mobile/nativewind-env.d.ts",
    "assets/",
    "apps/*/assets/",
    "apps/web/public/",
    "test-results/",
    "playwright-report/",
    "coverage/",
    "contracts/graphql/schema.graphql"
  ]
}
