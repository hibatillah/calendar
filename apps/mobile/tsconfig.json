{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "App.tsx",
    "app.config.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "android", "ios"]
}
