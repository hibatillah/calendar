<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Calendar" Manufacturer="hibatillah" Version="$(var.ProductVersion)"
           UpgradeCode="AA88641A-078C-443B-AD3C-259B25A04D99" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Calendar is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPCOMMENTS" Value="Calendar desktop app. User data is preserved when uninstalling." />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicensePath)" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Calendar">
        <Component Id="CalendarExecutable" Guid="2C0B7B8E-5B63-4E55-9E5A-1E7B0F6B7A11">
          <File Source="$(var.PackagePath)\calendar-desktop.exe" KeyPath="yes" />
        </Component>
        <Component Id="CalendarLauncher" Guid="6D3F1C2A-0A4B-4E0C-8B7E-3A9C2D5E8F22">
          <File Source="$(var.PackagePath)\Run-Calendar.cmd" KeyPath="yes" />
        </Component>
        <Component Id="CalendarDocuments" Guid="9A7E4D11-3B2C-4F6A-A1D8-5C0E7B9F3A33">
          <File Source="$(var.PackagePath)\.env.example" />
          <File Source="$(var.PackagePath)\google.md" />
          <File Source="$(var.PackagePath)\LICENSE" />
          <File Source="$(var.PackagePath)\README.md" KeyPath="yes" />
        </Component>
        <Directory Id="ThirdPartyLicenses" Name="third-party-licenses">
          <Component Id="CalendarFontLicense" Guid="4E8A2B67-7C1D-4A93-B5F0-2D6E9A1C4B44">
            <File Source="$(var.PackagePath)\third-party-licenses\OFL.txt" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CalendarMenuFolder" Name="Calendar">
        <Component Id="CalendarShortcuts" Guid="F1081173-2A78-4FC8-83F5-FE59DD84CC46">
          <Shortcut Id="StartCalendar" Name="Calendar" Target="[INSTALLFOLDER]Run-Calendar.cmd"
                    Show="minimized" WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="CalendarSetup" Name="Calendar setup guide" Target="[INSTALLFOLDER]google.md" />
          <Shortcut Id="UninstallCalendar" Name="Uninstall Calendar" Target="[System64Folder]msiexec.exe"
                    Arguments="/x [ProductCode]" />
          <RemoveFolder Id="RemoveCalendarMenu" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\Calendar" Name="Installed" Value="1" Type="integer" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="CalendarDesktopShortcut" Guid="0177766B-408F-42EE-A0D9-AE545E551CDB">
        <Shortcut Id="DesktopCalendar" Name="Calendar" Target="[INSTALLFOLDER]Run-Calendar.cmd"
                  Show="minimized" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\Calendar" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="CalendarApplication" Title="Calendar" Level="1">
      <ComponentRef Id="CalendarExecutable" />
      <ComponentRef Id="CalendarLauncher" />
      <ComponentRef Id="CalendarDocuments" />
      <ComponentRef Id="CalendarFontLicense" />
      <ComponentRef Id="CalendarShortcuts" />
      <ComponentRef Id="CalendarDesktopShortcut" />
    </Feature>
  </Package>
</Wix>
