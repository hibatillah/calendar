{
  "name": "calendar",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "build": "turbo run build",
    "codegen": "graphql-codegen --config codegen.ts",
    "test:web": "playwright test",
    "format": "prettier --write apps/web/src packages codegen.ts playwright.config.ts vitest.config.ts"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typed-document-node": "7.2.0",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
