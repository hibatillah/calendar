{
  "name": "calendar",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "build": "turbo run build",
    "codegen": "graphql-codegen --config codegen.ts",
    "test:web": "playwright test",
    "format": "oxfmt",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings apps packages tests *.ts"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typed-document-node": "7.2.0",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "serve": "14.2.6",
    "turbo": "2.11.8",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
